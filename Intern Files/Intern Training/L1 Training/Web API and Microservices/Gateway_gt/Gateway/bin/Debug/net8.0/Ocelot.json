{
  "Routes": [
    {
      "UpstreamPathTemplate": "/gateway/ShippingService",
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "DownstreamPathTemplate": "/api/ShippingService",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7206
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/gateway/ShippingService/{id}",
      "UpstreamHttpMethod": [ "GET", "PUT","DELETE" ],
      "DownstreamPathTemplate": "/api/ShippingService/{id}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7206
        }
      ]
    }
  ]
}
 