@model TimeEntries.Entity.TimeEntry

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>TimeEntry</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="EmployeeId" class="control-label"></label>
                <select asp-for="EmployeeId" class="form-control">
                    <option value="">-- Select Employee --</option>
                    <option value="12560">Ranjith</option>
                    <option value="12561">Rajesh</option>
                    <option value="12562">Aashik</option>
                    <option value="12563">Vignesh</option>
                    <option value="12564">Balaji</option>
                    <option value="12565">Nuttrenai</option>
                    <option value="12566">Kavya</option>
                    <option value="12567">Bangaru</option>
                    <option value="12568">Jeswanth</option>
                    <option value="12569">Tarun</option>
                    <option value="12570">Thangabalaji</option>
                    <option value="12571">Vishweshwaran</option>
                    <option value="12572">Mukesh</option>
                    <option value="12573">Arul Naveen</option>
                    <option value="12574">Terrance</option>
                    <option value="12575">Rishi</option>
                    <option value="12576">Nisanth</option>
                    <option value="12577">Arul Begonia</option>
                    <option value="12590">Mashavan</option>
                </select>
                <span asp-validation-for="EmployeeId" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="DateOfEntry" class="control-label"></label>
                <input asp-for="DateOfEntry" class="form-control" type="date" id="datePicker" />
                <span asp-validation-for="DateOfEntry" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="NumberOfHours" class="control-label"></label>
                <input asp-for="NumberOfHours" class="form-control" />
                <span asp-validation-for="NumberOfHours" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="TaskDescription" class="control-label"></label>
                <input asp-for="TaskDescription" class="form-control" />
                <span asp-validation-for="TaskDescription" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<br />

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {

    <script>
        const today = new Date().toISOString().split('T')[0];
        const dateInput = document.getElementById("datePicker");
        dateInput.min = today;
        dateInput.max = today;
        dateInput.value = today;

        const errorMessage = '@ViewBag.ErrorMessage';
        const tempError = '@TempData["ErrorMessage"]';

        if (errorMessage) {
            console.log("Server Error:", errorMessage);
        }

        if (tempError) {
            console.log("Server Error:", tempError);
        }
    </script>

    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
