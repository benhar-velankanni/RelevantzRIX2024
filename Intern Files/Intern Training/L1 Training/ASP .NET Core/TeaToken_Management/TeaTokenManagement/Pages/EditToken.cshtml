@page "{id:int}"
@model EditTokenModel
@{
    ViewData["Title"] = "Edit Token Entry";
}

<h2>Edit Token Entry</h2>

<form method="post" class="border p-4 bg-light rounded">
    <input type="hidden" asp-for="TokenLog.TeaTokenLogId" />

    <div class="mb-3">
        <label class="form-label">Employee:</label>
        <input class="form-control" value="@Model.TokenLog.Employee?.Name" disabled />
    </div>

    <div class="mb-3">
        <label class="form-label">Date:</label>
        <input type="date" asp-for="TokenLog.Date" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Session:</label>
        <select asp-for="TokenLog.Session" class="form-select">
            <option>Morning</option>
            <option>Evening</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Drink Type:</label>
        <select asp-for="TokenLog.DrinkType" class="form-select">
            <option>Tea</option>
            <option>Coffee</option>
            <option>Milk</option>

        </select>
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-page="/Reports" class="btn btn-secondary">Cancel</a>
</form>
