@model OnlineSalonManagementSystem.Models.Appointment

@{
    ViewData["Title"] = "Delete";
}

<div class="container p-3 my-3 bg-dark text-white">
    <h1>Delete</h1>

    <h3 class="text-warning">Are you sure you want to delete this?</h3>
    <div class="row">
        <div class="col-md-4">
            <dl class="row">
                <dt class="col-sm-6">
                    @Html.DisplayNameFor(model => model.Date)
                </dt>
                <dd class="col-sm-6">
                    @Html.DisplayFor(model => model.Date)
                </dd>
                <dt class="col-sm-6">
                    @Html.DisplayNameFor(model => model.Customer)
                </dt>
                <dd class="col-sm-6">
                    @Html.DisplayFor(model => model.Customer.Id)
                </dd>
                <dt class="col-sm-6">
                    @Html.DisplayNameFor(model => model.Service)
                </dt>
                <dd class="col-sm-6">
                    @Html.DisplayFor(model => model.Service.Id)
                </dd>
                <dt class="col-sm-6">
                    @Html.DisplayNameFor(model => model.Staff)
                </dt>
                <dd class="col-sm-6">
                    @Html.DisplayFor(model => model.Staff.Id)
                </dd>
            </dl>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <input type="submit" value="Delete" class="btn btn-danger" /> |
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </form>
        </div>
    </div>
</div>

