@model OnlineSalonManagementSystem.Models.AdminLog

@{
    ViewData["Title"] = "Register";
}

<h1 class="text-center" style="color:rgb(0, 0, 0)">Register</h1>

<hr />
<div class="row justify-content-center">
    <div class="col-md-4">
        <form asp-action="Register" style="background-color: #ffff99; padding: 20px; border-radius: 10px; box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2), 0 6px 20px 0 rgba(0,0,0,0.19);">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control border-success" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control border-success" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password" class="control-label"></label>
                <input asp-for="Password" class="form-control border-success" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group text-center">
                <input type="submit" value="Register" class="btn btn-success" style="background-color:rgb(0, 0, 0); color: white" />
            </div>
        </form>
    </div>
</div>

<div class="text-center">
    <a asp-action="Login" style="color: #28a745">Back to Login</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

